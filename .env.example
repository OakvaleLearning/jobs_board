# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost

# Database
DATABASE_URL=postgresql://oakvale:oakvale@postgres:5432/oakvale_jobs

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api/v1
INTERNAL_API_URL=http://backend:3000/api/v1

# S3 / R2 (Phase 1 — stubs OK for Phase 0)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Public base URL for the R2 bucket (r2.dev public URL e.g. https://pub-xxxx.r2.dev,
# or a bound custom domain). When set, file view/download URLs are permanent and
# unsigned. Requires public access to be enabled on the bucket. Required in production.
S3_PUBLIC_URL=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack (Phase 5)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Resend (Phase 7)
RESEND_API_KEY=
FROM_EMAIL=noreply@oakvaleltd.com

# Termii (Phase 7)
TERMII_API_KEY=
TERMII_SENDER_ID=Oakvale
