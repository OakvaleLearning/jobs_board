{
  "name": "@oakvale/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/backend/src/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed-admin": "tsx src/shared/db/seed-admin.ts",
    "db:seed-agent": "tsx src/shared/db/seed-agent.ts",
    "db:seed-categories": "tsx src/shared/db/seed-categories.ts",
    "db:seed-care-types": "tsx src/shared/db/seed-care-types.ts",
    "db:seed-employer-types": "tsx src/shared/db/seed-employer-types.ts",
    "db:seed-test": "tsx src/shared/db/seed-test-data.ts",
    "backfill:selfie-blur": "tsx src/scripts/backfill-selfie-blur.ts",
    "db:seed-all": "npm run db:seed-admin && npm run db:seed-agent && npm run db:seed-categories && npm run db:seed-care-types && npm run db:seed-employer-types && npm run db:seed-test",
    "lint": "eslint 'src/**/*.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.602.0",
    "@aws-sdk/s3-request-presigner": "^3.602.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@node-rs/argon2": "^1.8.3",
    "@oakvale/shared": "*",
    "bullmq": "^5.7.0",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.4",
    "resend": "^4.0.0",
    "sharp": "^0.33.5",
    "stripe": "^16.12.0",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.13.0",
    "drizzle-kit": "^0.21.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
